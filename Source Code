import './App.css';
import BookManager from './BookManager';
import Login from './Login';
import DatabaseBooks from './DatabaseBooks';
import { getAuth, onAuthStateChanged, signOut } from 'firebase/auth';
import React, { useEffect, useState } from 'react';

function App() {
  const [user, setUser] = useState(null);
  const auth = getAuth();

  useEffect(() => {
    const unsubscribe = onAuthStateChanged(auth, (u) => setUser(u));
    return () => unsubscribe();
  }, [auth]);

  const [showDatabaseBooks, setShowDatabaseBooks] = useState(false);

  if (!user) {
    return <Login onLogin={() => setUser(getAuth().currentUser)} />;
  }

  return (
    <div className="App">
      <button style={{ float: 'right', margin: 10 }} onClick={() => signOut(auth)}>Logout</button>
      <button style={{ margin: 10 }} onClick={() => setShowDatabaseBooks((v) => !v)}>
        {showDatabaseBooks ? 'Back to Book Manager' : 'View Database Books'}
      </button>
      {showDatabaseBooks ? <DatabaseBooks /> : <BookManager />}
    </div>
  );
}

export default App;

