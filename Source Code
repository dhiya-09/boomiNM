import React, { useEffect, useState, useCallback } from "react";
import { db } from "./firebase";
import { collection, getDocs, addDoc, updateDoc, deleteDoc, doc } from "firebase/firestore";

function BookManager() {
  const [books, setBooks] = useState([]);
  const [form, setForm] = useState({ title: "", author: "", year: "" });
  const [editingId, setEditingId] = useState(null);

  const booksCollection = collection(db, "books");


  // Fetch books from Firestore
  const fetchBooks = useCallback(async () => {
    const data = await getDocs(booksCollection);
    setBooks(data.docs.map((doc) => ({ ...doc.data(), id: doc.id })));
  }, [booksCollection]);

  useEffect(() => {
    fetchBooks();
  }, [fetchBooks]);

  // Add or update book
  const handleSubmit = async (e) => {
    e.preventDefault();
    if (editingId) {
      const bookDoc = doc(db, "books", editingId);
      await updateDoc(bookDoc, form);
      setEditingId(null);
    } else {
      await addDoc(booksCollection, { ...form, status: "available", borrower: "" });
    }
    setForm({ title: "", author: "", year: "" });
    fetchBooks();
  };

  // Edit book
  const handleEdit = (book) => {
    setForm({ title: book.title, author: book.author, year: book.year });
    setEditingId(book.id);
  };

  // Delete book
  const handleDelete = async (id) => {
    await deleteDoc(doc(db, "books", id));
    fetchBooks();
  };

  return (
    <div>
      <h2>Library Book Management</h2>
      <form onSubmit={handleSubmit}>
        <input
          placeholder="Title"
          value={form.title}
          onChange={(e) => setForm({ ...form, title: e.target.value })}
          required
        />
        <input
          placeholder="Author"
          value={form.author}
          onChange={(e) => setForm({ ...form, author: e.target.value })}
          required
        />
        <input
          placeholder="Year"
          value={form.year}
          onChange={(e) => setForm({ ...form, year: e.target.value })}
          required
        />
        <button type="submit">{editingId ? "Update" : "Add"} Book</button>
      </form>
      <ul>
        {books.map((book) => (
          <li key={book.id}>
            <b>{book.title}</b> by {book.author} ({book.year}) - {book.status}
            <button onClick={() => handleEdit(book)}>Edit</button>
            <button onClick={() => handleDelete(book.id)}>Delete</button>
          </li>
        ))}
      </ul>
    </div>
  );
}

export default BookManager;

DatabaseBooks.js
import React, { useEffect, useState } from "react";

function DatabaseBooks() {
  const [books, setBooks] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    fetch("http://localhost:5000/api/books")
      .then((res) => res.json())
      .then((data) => {
        setBooks(data);
        setLoading(false);
      })
      .catch((err) => {
        setError("Failed to fetch books from backend");
        setLoading(false);
      });
  }, []);

  if (loading) return <div>Loading books...</div>;
  if (error) return <div style={{ color: "red" }}>{error}</div>;

  return (
    <div>
      <h2>Books in Database</h2>
      <ul>
        {books.map((book) => (
          <li key={book._id}>
            <b>{book.title}</b> by {book.author} ({book.year}) - {book.status}
          </li>
        ))}
      </ul>
    </div>
  );
}

export default DatabaseBooks;

